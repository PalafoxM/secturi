<VirtualHost *:80>
    ServerName guanajuato.mx
    ServerAlias www.guanajuato.mx
    Redirect / https://guanajuato.mx
    DocumentRoot /var/www/html/mx.guanajuato.site3
    ErrorLog ${APACHE_LOG_DIR}/error.log
    CustomLog ${APACHE_LOG_DIR}/access.log combined
    LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" comb$
    <Directory "/var/www/html/mx.guanajuato.site3">
        Options -Indexes +FollowSymLinks
        AllowOverride All
        <IfModule mod_access_compat.c>
            Order allow,deny
            Allow from all
        </IfModule>
        <IfModule !mod_access_compat.c>
            Require all granted
        </IfModule>
    </Directory>
</VirtualHost>

<VirtualHost *:443>
   ServerName guanajuato.mx
    DocumentRoot /var/www/html/mx.guanajuato.site3
    ErrorLog ${APACHE_LOG_DIR}/error.log
    CustomLog -access_log combined
    LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
    <Directory "/var/www/html/mx.guanajuato.site3">
        Options -Indexes +FollowSymLinks
        AllowOverride All
        <IfModule mod_access_compat.c>
            Order allow,deny
            Allow from all
        </IfModule>
        <IfModule !mod_access_compat.c>
            Require all granted
        </IfModule>
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L]
</IfModule>
    </Directory>
    SSLEngine on
    #SSLCertificateFile /etc/ssl/certscomodingtomx/ae1c6ca26fbfaf7.crt
    #SSLCertificateKeyFile /etc/ssl/certscomodingtomx/generated-private.key
    #SSLCertificateChainFile /etc/ssl/certscomodingtomx/gd_bundle-g2-g1.crt
    SSLCertificateFile /etc/ssl/godaddy24/330b5e0aae1f1a35.crt
    SSLCertificateKeyFile /etc/ssl/godaddy23/generated-private.key
    SSLCertificateChainFile /etc/ssl/godaddy24/gd_bundle-g2-g1.crt
</VirtualHost>



